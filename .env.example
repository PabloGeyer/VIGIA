# Copiá este archivo como .env y completá los valores.
# El .env real NUNCA se sube al repo (está en .gitignore).

# Servidor
PORT=8080
BASE_URL=http://localhost:8080

# Base de datos
DATABASE_URL=postgres://vigia:vigia@localhost:5432/vigia

# Alertas por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertas por mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# Diagnóstico con IA (opcional; si se deja vacío, Vigía funciona sin IA)
# Proveedores: anthropic | openai | ollama
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Solo para Ollama (modelo local)
OLLAMA_BASE_URL=http://localhost:11434
