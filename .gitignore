# ── Secretos y configuración local ─────────────────────────
# Nunca subir tokens de Telegram, credenciales SMTP, claves, etc.
.env
.env.*
!.env.example
*.pem
*.key

# ── Datos locales ──────────────────────────────────────────
# Base de datos SQLite de desarrollo y volúmenes de Docker
*.db
*.sqlite
*.sqlite3
data/
volumes/

# ── Logs ───────────────────────────────────────────────────
logs/
*.log

# ── Node.js / TypeScript (backend y panel web) ─────────────
node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Python (por si se usa para scripts o el backend) ───────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Go (por si se usa para el backend) ─────────────────────
/bin/
*.exe
*.test

# ── Editores e IDEs ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ── Sistema operativo ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temporales ─────────────────────────────────────────────
tmp/
.cache/
